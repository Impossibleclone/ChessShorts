# PostgreSQL connection string
# Local dev (docker compose):
#   postgresql+asyncpg://postgres:postgres@localhost:5432/chessshorts
# Neon / cloud (requires TLS - handled automatically by app/db/base.py):
#   postgresql+asyncpg://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chessshorts

# development | production (production restricts CORS origins)
ENVIRONMENT=development